# Database
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vinevault_core_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT
SECRET_KEY=tu_clave_secreta_muy_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service
SERVICE_NAME=vinevault-core
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=vinevault-core
# Optional integrations
BILLING_SERVICE_URL=http://localhost:8001

# Inventory AI (optional; empty cellars never require a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_TEMPERATURE=0.0
GEMINI_REQUEST_TIMEOUT_SECONDS=20
